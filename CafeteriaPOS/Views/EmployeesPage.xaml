<Page
    x:Class="CafeteriaPOS.Views.EmployeesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CafeteriaPOS.Models">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     MaxLength="30"
                     PlaceholderText="🔍 Buscar por nombre o usuario..."
                     TextChanged="Busqueda_TextChanged"
                     Text="{x:Bind ViewModel.TextoBusqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Border Grid.Row="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ListView ItemsSource="{x:Bind ViewModel.EmpleadosFiltrados}"
                          SelectedItem="{x:Bind ViewModel.EmpleadoSeleccionado, Mode=TwoWay}"
                          SelectionMode="Single">

                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="8"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nombre"  FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Usuario" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Puesto"  FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Empleado">
                            <Grid Padding="12,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Nombre}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Usuario}" Foreground="#FF7A6147" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Puesto}"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ColorPuesto, Mode=OneWay}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
        
        <Border Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="20">

            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind ViewModel.TituloFormulario, Mode=OneWay}"
                           FontSize="18" FontWeight="Bold"/>

                <StackPanel Grid.Row="1" Spacing="12">
                    <TextBox Header="Nombre completo"
                             MaxLength="30"
                             PlaceholderText="Ej: Juan Pérez"
                             TextChanged="FormNombre_TextChanged"
                             Text="{x:Bind ViewModel.FormNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox x:Name="FormUserTextBox"
                             Header="Usuario"
                             BeforeTextChanging="FormUserTextBox_BeforeTextChanging"
                             PlaceholderText="Ej: jperez"
                             MaxLength="20"
                             Text="{x:Bind ViewModel.FormUsuario, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <PasswordBox x:Name="FormPasswordBox"
                                 Header="Contraseña"
                                 MaxLength="4"
                                 PlaceholderText="{x:Bind ViewModel.HintPassword, Mode=OneWay}"
                                 PasswordChanged="FormPasswordBox_PasswordChanged"/>
                                   

                    <ComboBox Header="Puesto"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.PuestosDisponibles}"
                              SelectedItem="{x:Bind ViewModel.FormPuesto, Mode=TwoWay}"/>

                    <TextBlock Text="{x:Bind ViewModel.MensajeEstado, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.MensajeEstado, Mode=OneWay, Converter={StaticResource MessageBrushConverter}}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8">
                    <Button Content="{x:Bind ViewModel.TextoBotonGuardar, Mode=OneWay}"
                            Command="{x:Bind ViewModel.GuardarCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="12,12" CornerRadius="8"
                            Background="#38240E" Foreground="White" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancelar"
                                Command="{x:Bind ViewModel.CancelarCommand}"
                                HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="1" Content="🗑️ Eliminar"
                                Command="{x:Bind ViewModel.EliminarCommand}"
                                IsEnabled="{x:Bind ViewModel.HaySeleccion, Mode=OneWay}"
                                HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Button Content="➕ Nuevo empleado"
                            Command="{x:Bind ViewModel.NuevoCommand}"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>