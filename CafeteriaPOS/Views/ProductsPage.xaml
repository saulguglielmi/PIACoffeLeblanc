<Page
    x:Class="CafeteriaPOS.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CafeteriaPOS.Models"
    xmlns:helpers="using:CafeteriaPOS.Helpers">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBox PlaceholderText="🔍 Buscar producto por nombre..."
                         MaxLength="30"
                         Text="{x:Bind ViewModel.TextoBusqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Categoría"
                          ItemsSource="{x:Bind ViewModel.Categorias}"
                          SelectedItem="{x:Bind ViewModel.CategoriaFiltro, Mode=TwoWay}"/>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListView ItemsSource="{x:Bind ViewModel.ProductosFiltrados}"
                          SelectedItem="{x:Bind ViewModel.ProductoSeleccionado, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Producto"  FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Categoría" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Precio"    FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="Stock"     FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Producto">
                            <Grid Padding="12,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind Nombre}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Categoria}" Foreground="#FF7A6147" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Precio, Converter={StaticResource MoneyConverter}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Stock, Mode=OneWay}"
                                           Foreground="{x:Bind ColorStock, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Expander Grid.Row="2"
                      Header="⚙️ Administrar categorías"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,4,0,8">

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox PlaceholderText="Nueva categoría (máx. 15)"
                                 TextChanged="Categoria_TextChanged"
                                 Text="{x:Bind ViewModel.NuevaCategoria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1"
                                Content="➕ Agregar"
                                Command="{x:Bind ViewModel.AgregarCategoriaCommand}"/>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.CategoriasDisponibles}"
                              SelectedItem="{x:Bind ViewModel.CategoriaEditadaSeleccionada, Mode=TwoWay}"
                              SelectionMode="Single"
                              MaxHeight="120"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="4"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox PlaceholderText="Nuevo nombre"
                                 TextChanged="Categoria_TextChanged"
                                 Text="{x:Bind ViewModel.NombreCategoriaEditado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="1"
                                Content="Actualizar"
                                Command="{x:Bind ViewModel.ActualizarCategoriaCommand}"
                                IsEnabled="{x:Bind ViewModel.HayCategoriaSeleccionada, Mode=OneWay}"/>

                        <Button Grid.Column="2"
                                Content="🗑️ Eliminar"
                                ToolTipService.ToolTip="Eliminar categoría"
                                Command="{x:Bind ViewModel.EliminarCategoriaCommand}"
                                IsEnabled="{x:Bind ViewModel.HayCategoriaSeleccionada, Mode=OneWay}"/>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.MensajeCategoria, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.MensajeCategoria, Mode=OneWay, Converter={StaticResource MessageBrushConverter}}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
        </Grid>

        <Border Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">

            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{x:Bind ViewModel.TituloFormulario, Mode=OneWay}"
                           FontSize="18" FontWeight="Bold"/>

                <StackPanel Grid.Row="1" Spacing="12">

                    <TextBox Header="Nombre"
                             PlaceholderText="Ej: Capuchino"
                             MaxLength="20"
                             Text="{x:Bind ViewModel.FormNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Header="Categoría"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Selecciona una categoría"
                              ItemsSource="{x:Bind ViewModel.CategoriasDisponibles}"
                              SelectedItem="{x:Bind ViewModel.FormCategoria, Mode=TwoWay}"/>

                    <helpers:NumericNumberBox Header="Precio"
                               Minimum="0"
                               Maximum="9999.999"
                               SmallChange="0.5"
                               SpinButtonPlacementMode="Hidden"
                               helpers:NumericInput.MaxDigits="4"
                               helpers:NumericInput.AllowDecimal="True"
                               helpers:NumericInput.MaxDecimals="3"
                               Value="{x:Bind ViewModel.FormPrecio, Mode=TwoWay}"/>

                    <helpers:NumericNumberBox Header="Stock actual"
                               Minimum="0"
                               Maximum="9999"
                               SpinButtonPlacementMode="Hidden"
                               helpers:NumericInput.MaxDigits="4"
                               Value="{x:Bind ViewModel.FormStock, Mode=TwoWay}"/>

                    <helpers:NumericNumberBox Header="Stock mínimo (alerta)"
                               Minimum="0"
                               Maximum="9999"
                               SpinButtonPlacementMode="Hidden"
                               helpers:NumericInput.MaxDigits="4"
                               Value="{x:Bind ViewModel.FormStockMinimo, Mode=TwoWay}"/>

                    <TextBlock Text="{x:Bind ViewModel.MensajeEstado, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.MensajeEstado, Mode=OneWay, Converter={StaticResource MessageBrushConverter}}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- botones -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <Button Content="{x:Bind ViewModel.TextoBotonGuardar, Mode=OneWay}"
                            Command="{x:Bind ViewModel.GuardarCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="12,12"
                            CornerRadius="8"
                            Background="#38240E"
                            Foreground="White"
                            FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancelar"
                                Command="{x:Bind ViewModel.CancelarCommand}"
                                HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="1"
                                Content="🗑️ Eliminar"
                                Command="{x:Bind ViewModel.EliminarCommand}"
                                IsEnabled="{x:Bind ViewModel.HaySeleccion, Mode=OneWay}"
                                HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Button Content="Nuevo producto"
                            Command="{x:Bind ViewModel.NuevoCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>