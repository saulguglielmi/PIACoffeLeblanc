<Window
    x:Class="CafeteriaPOS.Views.AiChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CafeteriaPOS.Models"
    Title="Morgana · Asistente virtual">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF2C1F12" Offset="0.0"/>
                <GradientStop Color="#FF21160C" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="#FF38240E"
                BorderBrush="#FF4C3922"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="38"
                         Height="38"
                         VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="ms-appx:///Assets/morgana.png" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="Morgana"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FFF3EEE2"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Asistente virtual · Café Leblanc"
                               FontSize="11"
                               Foreground="#FFC7B79C"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Limpiar chat"
                        Click="LimpiarChat_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"     Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonForeground"            Color="#FFD5CFBA"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFF3EEE2"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed"     Color="#FFF3EEE2"/>
                        <SolidColorBrush x:Key="ButtonBorderBrush"           Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"    Color="Transparent"/>
                    </Button.Resources>
                    <FontIcon Glyph="&#xE74D;" FontSize="15" FontFamily="Segoe MDL2 Assets"/>
                </Button>
            </Grid>
        </Border>

        <!-- Historial de chat -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ChatScroll"
                      Padding="16"
                      VerticalScrollBarVisibility="Auto">
            <ItemsRepeater ItemsSource="{x:Bind Mensajes}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10"/>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Border Background="{x:Bind ColorFondo, Mode=OneWay}"
                                CornerRadius="12"
                                Padding="14,10"
                                MaxWidth="360"
                                HorizontalAlignment="{x:Bind Alineacion, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Texto}"
                                       Foreground="{x:Bind ColorTexto, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       LineHeight="19"/>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Entrada -->
        <Border Grid.Row="2"
                Background="#FF38240E"
                BorderBrush="#FF4C3922"
                BorderThickness="0,1,0,0"
                Padding="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PreguntaBox"
                         Grid.Column="0"
                         PlaceholderText="Pregúntame algo..."
                         KeyDown="PreguntaBox_KeyDown"
                         IsEnabled="True"
                         Foreground="#FFF3EEE2"
                         BorderThickness="1"
                         CornerRadius="8">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground"                       Color="#FF2A1D11"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver"            Color="#FF322314"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused"                Color="#FF2A1D11"/>
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled"               Color="#FF241A10"/>

                        <SolidColorBrush x:Key="TextControlForeground"                       Color="#FFF3EEE2"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver"            Color="#FFF3EEE2"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused"                Color="#FFF3EEE2"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled"               Color="#FFB7A88F"/>

                        <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="#FFB7A88F"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FFB7A88F"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="#FFB7A88F"/>

                        <SolidColorBrush x:Key="TextControlBorderBrush"                      Color="#FF5A4632"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"           Color="#FF7A6147"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused"               Color="#FFD5CFBA"/>

                        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush"      Color="#FFD5CFBA"/>
                        <SolidColorBrush x:Key="TextControlElevationBorderBrush"             Color="#FF5A4632"/>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="EnviarBtn"
                        Grid.Column="1"
                        Padding="14,8"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="Enviar_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground"             Color="#FFD5CFBA"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#FFE3DDCC"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#FFC8C1AA"/>
                        <SolidColorBrush x:Key="ButtonForeground"             Color="#FF38240E"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#FF38240E"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#FF38240E"/>
                        <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent"/>
                    </Button.Resources>
                    <FontIcon Glyph="&#xE724;" FontSize="16" FontFamily="Segoe MDL2 Assets"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
