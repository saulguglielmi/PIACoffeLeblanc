<Page
    x:Class="CafeteriaPOS.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CafeteriaPOS.ViewModels"
    xmlns:models="using:CafeteriaPOS.Models"
    xmlns:helpers="using:CafeteriaPOS.Helpers">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="🔍 Buscar producto..."
                         Text="{x:Bind ViewModel.TextoBusqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Categorias}"
                          SelectedItem="{x:Bind ViewModel.CategoriaSeleccionada, Mode=TwoWay}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ProductosFiltrados}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="200"
                                           MinItemHeight="140"
                                           MinRowSpacing="12"
                                           MinColumnSpacing="12"/>
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Producto">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{x:Bind RellenoFondo, Mode=OneWay}"
                                    BorderBrush="{x:Bind RellenoBorde, Mode=OneWay}"
                                    BorderThickness="2"
                                    Click="Producto_Click"
                                    IsEnabled="{x:Bind Disponible, Mode=OneWay}"
                                    Tag="{x:Bind}">

                                <StackPanel Spacing="4">
                                  
                                    <TextBlock Text="{x:Bind Nombre}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{x:Bind Categoria}"
                                               FontSize="11"
                                               Foreground="#FF7A6147"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{x:Bind Precio, Mode=OneWay, Converter={StaticResource MoneyConverter}}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#38240E"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="{x:Bind TextoStock, Mode=OneWay}"
                                               FontSize="11"
                                               Margin="0,6,0,0"
                                               Foreground="{x:Bind ColorStock, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado del carrito -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Orden actual" FontSize="18" FontWeight="Bold"/>
                    <Button Content="Vaciar"
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.VaciarCarritoCommand}"/>
                </Grid>

                <!-- Lista del carrito -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Carrito}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CarritoItem">
                            <Grid Padding="0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Producto.Nombre}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Producto.Precio, Mode=OneWay, Converter={StaticResource MoneyConverter}}"
                                               FontSize="11" Foreground="#FF7A6147"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="−" Width="32"
                                        Click="Disminuir_Click"
                                        Tag="{x:Bind}"/>

                                <TextBlock Grid.Column="2" Text="{x:Bind Cantidad, Mode=OneWay}"
                                           VerticalAlignment="Center" Width="24"
                                           TextAlignment="Center" FontWeight="SemiBold"/>

                                <Button Grid.Column="3" Content="+" Width="32"
                                        Click="Aumentar_Click"
                                        Tag="{x:Bind}"/>

                                <TextBlock Grid.Column="4" Text="{x:Bind Subtotal, Mode=OneWay, Converter={StaticResource MoneyConverter}}"
                                           VerticalAlignment="Center" Width="70"
                                           TextAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Spacing="10">

                    <TextBlock Text="Propina" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="5%"  Command="{x:Bind ViewModel.AplicarPropinaPorcentajeCommand}" CommandParameter="5"/>
                        <Button Content="10%" Command="{x:Bind ViewModel.AplicarPropinaPorcentajeCommand}" CommandParameter="10"/>
                        <Button Content="15%" Command="{x:Bind ViewModel.AplicarPropinaPorcentajeCommand}" CommandParameter="15"/>
                        <helpers:NumericNumberBox Value="{x:Bind ViewModel.Propina, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Hidden"
                                   Minimum="0"
                                   Maximum="9999.999"
                                   SmallChange="1"
                                   helpers:NumericInput.MaxDigits="4"
                                   helpers:NumericInput.AllowDecimal="True"
                                   helpers:NumericInput.MaxDecimals="3"
                                   PlaceholderText="Libre"/>
                    </StackPanel>

                    <TextBlock Text="Método de pago" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton Content="Efectivo"
                                     GroupName="Pago"
                                     IsChecked="{x:Bind ViewModel.EsEfectivo, Mode=TwoWay}"/>
                        <RadioButton Content="Tarjeta"
                                     GroupName="Pago"
                                     IsChecked="{x:Bind ViewModel.EsTarjeta, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.EsEfectivo, Mode=OneWay}">
                        <helpers:NumericNumberBox Header="Paga con"
                                   Value="{x:Bind ViewModel.PagoCliente, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="9999.999"
                                   SpinButtonPlacementMode="Hidden"
                                   helpers:NumericInput.MaxDigits="4"
                                   helpers:NumericInput.AllowDecimal="True"
                                   helpers:NumericInput.MaxDecimals="3" />
                        <TextBlock>
                            <Run Text="Cambio:"/>
                            <Run Text="{x:Bind ViewModel.Cambio, Mode=OneWay, Converter={StaticResource MoneyConverter}}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.MensajeEstado, Mode=OneWay}"
                               Foreground="{x:Bind ViewModel.MensajeEstado, Mode=OneWay, Converter={StaticResource MessageBrushConverter}}"
                               TextWrapping="Wrap"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="6">
                    <Grid>
                        <TextBlock Text="Subtotal"/>
                        <TextBlock Text="{x:Bind ViewModel.Subtotal, Mode=OneWay, Converter={StaticResource MoneyConverter}}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Propina"/>
                        <TextBlock Text="{x:Bind ViewModel.Propina, Mode=OneWay, Converter={StaticResource MoneyConverter}}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="TOTAL" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{x:Bind ViewModel.Total, Mode=OneWay, Converter={StaticResource MoneyConverter}}"
                                   HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"/>
                    </Grid>

                    <Button Content="Cobrar"
                            HorizontalAlignment="Stretch"
                            Padding="12,14"
                            CornerRadius="8"
                            Background="#38240E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="15"
                            IsEnabled="{x:Bind ViewModel.PuedeCobrar, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CobrarCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>